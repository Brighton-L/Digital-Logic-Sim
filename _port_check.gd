extends SceneTree
const Circuit = preload("res://logic_circuit.gd")
func _initialize() -> void:
	var c = Circuit.new()
	c.resize_inputs(2)
	var g = c.add_gate("AND", Vector2.ZERO)
	c.connect_ports("INPUT_0", "input", g["id"], "AND_left_top")
	c.connect_ports("INPUT_1", "input", g["id"], "AND_left_bottom")
	c.connect_ports(g["id"], "AND_right", "OUTPUT_0", "output")
	c.set_input(0, true)
	assert(not c.outputs[0])
	c.set_input(1, true)
	assert(c.outputs[0])
	c.set_input(0, false)
	assert(not c.outputs[0])
	c.set_input(0, true)
	assert(c.encapsulate("Both"))
	assert(c.gates.size() == 1 and c.custom_gates.size() == 1)
	var composite = c.gates[0]
	c.connect_ports("INPUT_0", "input", composite["id"], "INPUT_0_input")
	c.connect_ports("INPUT_1", "input", composite["id"], "INPUT_1_input")
	c.connect_ports(composite["id"], "OUTPUT_0_output", "OUTPUT_0", "output")
	c.simulate()
	assert(c.outputs[0])
	c.set_input(1, false)
	assert(not c.outputs[0])
	var saved = c.to_dict()
	var loaded = Circuit.new()
	loaded.load_dict(saved)
	assert(not loaded.outputs[0] and loaded.custom_gates.size() == 1)
	loaded.set_input(1, true)
	assert(loaded.outputs[0])
	var n = Circuit.new()
	var inverter = n.add_gate("NOT", Vector2.ZERO)
	n.connect_ports("INPUT_0", "input", inverter["id"], "NOT_left")
	n.connect_ports(inverter["id"], "NOT_right", "OUTPUT_0", "output")
	assert(n.outputs[0])
	n.set_input(0, true)
	assert(not n.outputs[0])
	n.connections.clear()
	n.simulate()
	assert(not n.outputs[0])
	var clock = n.add_gate("CLK", Vector2.ZERO)
	n.connect_ports(clock["id"], "CLK_out", "OUTPUT_0", "output")
	assert(not n.outputs[0])
	n.tick_clocks()
	assert(n.outputs[0])
	n.tick_clocks()
	assert(not n.outputs[0])
	var display = Circuit.new()
	var segment = display.add_gate("7SEG", Vector2.ZERO)
	display.connect_ports("INPUT_0", "input", segment["id"], "7SEG_a")
	assert(display.encapsulate("Indicator"))
	var indicator = display.gates[0]
	display.connect_ports("INPUT_0", "input", indicator["id"], "INPUT_0_input")
	display.set_input(0, true)
	assert(display.states.get(Circuit.key(indicator["id"], "7SEG_a"), false))
	var clock_circuit = Circuit.new()
	var internal_clock = clock_circuit.add_gate("CLK", Vector2.ZERO)
	clock_circuit.connect_ports(internal_clock["id"], "CLK_out", "OUTPUT_0", "output")
	assert(clock_circuit.encapsulate("Pulse"))
	var pulse = clock_circuit.gates[0]
	clock_circuit.connect_ports(pulse["id"], "OUTPUT_0_output", "OUTPUT_0", "output")
	assert(not clock_circuit.outputs[0])
	clock_circuit.tick_clocks()
	assert(clock_circuit.outputs[0])
	clock_circuit.tick_clocks()
	assert(not clock_circuit.outputs[0])
	var saved_clock = clock_circuit.to_dict()
	var reloaded_clock = Circuit.new()
	reloaded_clock.load_dict(saved_clock)
	reloaded_clock.tick_clocks()
	assert(reloaded_clock.outputs[0])
	clock_circuit.connections.clear()
	clock_circuit.connect_ports(pulse["id"], "OUTPUT_0_output", "OUTPUT_0", "output")
	assert(clock_circuit.encapsulate("Nested Pulse"))
	var nested_pulse = clock_circuit.gates[0]
	clock_circuit.connect_ports(nested_pulse["id"], "OUTPUT_0_output", "OUTPUT_0", "output")
	clock_circuit.tick_clocks()
	assert(clock_circuit.outputs[0])
	var multi = Circuit.new()
	multi.resize_inputs(2)
	var first_display = multi.add_gate("7SEG", Vector2.ZERO)
	var second_display = multi.add_gate("7SEG", Vector2.ZERO)
	multi.connect_ports("INPUT_0", "input", first_display["id"], "7SEG_a")
	multi.connect_ports("INPUT_1", "input", second_display["id"], "7SEG_b")
	assert(multi.encapsulate("Two displays"))
	var pair = multi.gates[0]
	var paths = Circuit.display_paths(pair["composite"])
	assert(paths.size() == 2)
	multi.connect_ports("INPUT_0", "input", pair["id"], "INPUT_0_input")
	multi.connect_ports("INPUT_1", "input", pair["id"], "INPUT_1_input")
	multi.set_input(0, true)
	assert(multi.states.get(Circuit.key(pair["id"], Circuit.display_port(paths[0], "7SEG_a")), false))
	assert(not multi.states.get(Circuit.key(pair["id"], Circuit.display_port(paths[1], "7SEG_b")), false))
	multi.set_input(1, true)
	assert(multi.states.get(Circuit.key(pair["id"], Circuit.display_port(paths[1], "7SEG_b")), false))
	var saved_pair = multi.to_dict()
	var restored_pair = Circuit.new()
	restored_pair.load_dict(saved_pair)
	assert(Circuit.display_paths(restored_pair.gates[0]["composite"]).size() == 2)
	assert(restored_pair.states.get(Circuit.key(pair["id"], Circuit.display_port(paths[0], "7SEG_a")), false))
	multi.connections.clear()
	multi.connect_ports("INPUT_0", "input", pair["id"], "INPUT_0_input")
	multi.connect_ports("INPUT_1", "input", pair["id"], "INPUT_1_input")
	assert(multi.encapsulate("Nested displays"))
	var nested_pair = multi.gates[0]
	var nested_paths = Circuit.display_paths(nested_pair["composite"])
	assert(nested_paths.size() == 2)
	multi.connect_ports("INPUT_0", "input", nested_pair["id"], "INPUT_0_input")
	multi.connect_ports("INPUT_1", "input", nested_pair["id"], "INPUT_1_input")
	multi.simulate()
	assert(multi.states.get(Circuit.key(nested_pair["id"], Circuit.display_port(nested_paths[0], "7SEG_a")), false))
	assert(multi.states.get(Circuit.key(nested_pair["id"], Circuit.display_port(nested_paths[1], "7SEG_b")), false))
	print("PORT_CHECK_OK")
	quit()
